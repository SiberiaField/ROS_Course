      <geometry>
        <box size="0.1 0.05 0.05"/>
      </geometry>
      <origin rpy="0 0 1.57075" xyz="0 -0.05 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.05 0.05"/>
      </geometry>
      <origin rpy="0 0 1.57075" xyz="0 -0.05 0"/>
