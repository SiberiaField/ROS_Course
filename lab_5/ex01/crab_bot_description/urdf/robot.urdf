<?xml version="1.0"?>
<robot name="crab_bot">

  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.01333" ixy="0.0" ixz="0.0" iyy="0.01333" iyz="0.0" izz="0.01333"/>
    </inertial>
  </link>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0.0 0.0 -0.1175" rpy="0 0 0"/>
  </joint>

  <link name="right_eye">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0.025 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0.025 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000026" ixy="0.0" ixz="0.0" iyy="0.000026" iyz="0.0" izz="0.00003"/>
      <origin rpy="0 1.57075 0" xyz="0.025 0 0"/>
    </inertial>
  </link>
  <joint name="base_to_right_eye" type="fixed">
    <parent link="base_link"/>
    <child link="right_eye"/>
    <origin xyz="0.1 -0.045 0.1"/>
  </joint>

  <link name="left_eye">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0.025 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.05" radius="0.035"/>
      </geometry>
      <origin rpy="0 1.57075 0" xyz="0.025 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000026" ixy="0.0" ixz="0.0" iyy="0.000026" iyz="0.0" izz="0.00003"/>
      <origin rpy="0 1.57075 0" xyz="0.025 0 0"/>
    </inertial>
  </link>
  <joint name="base_to_left_eye" type="fixed">
    <parent link="base_link"/>
    <child link="left_eye"/>
    <origin xyz="0.1 0.045 0.1"/>
  </joint>

  <link name="right_arm">
